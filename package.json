{
  "name": "@local/dsh-ccswitch-hub",
  "version": "1.0.0",
  "type": "module",
  "description": "Manage MCP servers and skills for DeepSeek Harness, with optional CC Switch compatibility.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "author": {
    "name": "RedCarl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedCarl/dsh-ccswitch-hub.git"
  },
  "homepage": "https://github.com/RedCarl/dsh-ccswitch-hub",
  "bugs": {
    "url": "https://github.com/RedCarl/dsh-ccswitch-hub/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "mcp",
    "skills",
    "cc-switch"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
